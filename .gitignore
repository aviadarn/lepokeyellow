# ROMs are never committed. Bring your own legally acquired dump.
*.gb
*.gbc
*.sav

# Save states hold game RAM, so they are derived from the ROM. Not committed.
*.state
states/

# Large or regenerable artifacts.
episodes/
# Downloaded video, pret symbol file, collected PokeDreamer-schema chunks.
data/
checkpoints/
# CEM plan JSON, not docs/superpowers/plans -- a bare `plans/` matched at any
# depth and swallowed the implementation plans, so the plan a branch was built
# from could not be reviewed from history.
/plans/
mlruns/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Smoke-test screenshots only. results/ and docs/ figures ARE committed:
# a .gitignore entry that quietly swallows run data is how you end up
# pushing an empty results directory three commits in a row.
/before.png
/after.png
/frame.png
*.ram
